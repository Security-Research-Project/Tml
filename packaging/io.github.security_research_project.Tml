app-id: io.github.security_research_project.Tml
runtime: org.gnome.Platform
runtime-version: "50"
sdk: org.gnome.Sdk
command: tml

finish-args:
  - --share=network
  - --socket=wayland
  - --socket=fallback-x11
  - --share=ipc
  - --talk-name=org.freedesktop.Notifications
  - --filesystem=xdg-data/applications:create

modules:
  - name: tml
    buildsystem: simple

    build-commands:
      - pip3 install --verbose --no-index --find-links="file://${PWD}" --prefix=${FLATPAK_DEST} . --no-build-isolation

      - install -Dm644 packaging/org.tml.Tml.desktop \
          ${FLATPAK_DEST}/share/applications/org.tml.Tml.desktop

      - install -Dm644 packaging/flatpak/org.tml.Tml.metainfo.xml \
          ${FLATPAK_DEST}/share/metainfo/io.github.security_research_project.Tml.metainfo.xml

      - install -Dm644 tml/data/icons/org.tml.Tml.svg \
          ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/org.tml.Tml.svg

      - install -Dm644 tml/data/icons/org.tml.Tml-symbolic.svg \
          ${FLATPAK_DEST}/share/icons/hicolor/symbolic/apps/org.tml.Tml-symbolic.svg

      - install -Dm644 LICENSE \
          ${FLATPAK_DEST}/share/licenses/${FLATPAK_ID}/LICENSE

    sources:
      - type: git
        url: https://github.com/Security-Research-Project/Tml.git
        tag: v0.1.1
        commit: 0dcabc69d00a7e74e4607a855d953f560bfda3ad
